{
	"name": "smartflowsocial-cache-worker",
	"version": "0.0.0",
	"private": true,
	"description": "Primal-compatible cache API for SmartFlowSocial. Reads NostrMash first and falls back to Primal Cache.",
	"author": "SmartFlowSocial",
	"license": "Unlicense",
	"homepage": "https://smartflow.social",
	"repository": {
		"type": "git",
		"url": "https://github.com/xdzczk/smartflowsocial-cache-worker.git"
	},
	"bugs": {
		"url": "https://github.com/xdzczk/smartflowsocial-cache-worker/issues"
	},
	"type": "module",
	"packageManager": "pnpm@10.27.0",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:ci": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"cf-types": "wrangler types",
		"cf-types:check": "wrangler types && git diff --exit-code worker-configuration.d.ts",
		"validate": "pnpm run format:check && pnpm run lint:ci && pnpm run typecheck && pnpm run cf-types:check && pnpm run test"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.14.1",
		"@eslint/js": "^9.39.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.0.0",
		"prettier": "3.7.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vitest": "4.1.2",
		"wrangler": "^4.80.0"
	}
}
